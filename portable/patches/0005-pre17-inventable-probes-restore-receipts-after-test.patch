+    # Runner rewrites generated_at_* and index digests in-tree. Snapshot and
+    # restore so pytest does not leave sha256/timestamp drift in the checkout.
+    tracked = [os.path.join(PROBES, name) for name in EXPECTED]
+    tracked.append(os.path.join(PROBES, "INVENTABLE_PROBES_INDEX.json"))
+    before = {path: open(path, "rb").read() for path in tracked if os.path.isfile(path)}
+    try:
