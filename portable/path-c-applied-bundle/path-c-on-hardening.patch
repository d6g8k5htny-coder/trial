From b4fdbdc1aaf43aede7f42b6dca2358806f7299ed Mon Sep 17 00:00:00 2001
From: path-c-refresh <path-c-refresh@local>
Date: Thu, 24 Sep 2026 19:56:14 +0000
Subject: [PATCH] portable engineering patches (apply_all 0001-0004+0008-0016)
 on a1ed37b

---
 tests/test_attestations.py  | 3 ++-
 tools/attestations_check.py | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/tests/test_attestations.py b/tests/test_attestations.py
index c0c9244..5c04043 100644
--- a/tests/test_attestations.py
+++ b/tests/test_attestations.py
@@ -290,6 +290,7 @@ def test_schema_pins_the_three_invariants():
 
 def test_checker_docstring_states_what_it_does_not_establish():
     import ast
-    doc = ast.get_docstring(ast.parse(open(CHECKER, encoding="utf-8").read())) or ""
+    with open(CHECKER, encoding="utf-8") as handle:
+        doc = ast.get_docstring(ast.parse(handle.read())) or ""
     assert "not establish" in doc.lower()
     assert "not deployed" in doc.lower()
diff --git a/tools/attestations_check.py b/tools/attestations_check.py
index 05cfdf2..656031d 100644
--- a/tools/attestations_check.py
+++ b/tools/attestations_check.py
@@ -117,7 +117,8 @@ def check_record(record: dict, schema: dict, stem: str,
     path = record["object_id"].split(" @ ")[0].strip()
     candidate = os.path.join(ROOT, path)
     if os.path.isfile(candidate):
-        raw = open(candidate, "rb").read()
+        with open(candidate, "rb") as handle:
+            raw = handle.read()
         digest = hashlib.sha256(raw).hexdigest()
         if digest != record["object_sha256"] or len(raw) != record["object_bytes"]:
             successor = record.get("superseded_by")
